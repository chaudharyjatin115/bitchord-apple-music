<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Frosted Dark Background -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="135"
                android:startColor="#60202A2E"
                android:centerColor="#38141E22"
                android:endColor="#4810181B"
                android:type="linear" />
        </shape>
    </item>
    <!-- Specular Highlight Border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#45FFFFFF" />
        </shape>
    </item>
</layer-list>
