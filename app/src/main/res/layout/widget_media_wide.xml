<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <!-- Left Album Art -->
        <ImageView
            android:id="@+id/widget_thumb"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true" />

        <!-- Right Pane -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_toEndOf="@id/widget_thumb"
            android:layout_marginStart="14dp"
            android:layout_centerVertical="true">

            <!-- Top Right BitChord Logo Icon -->
            <ImageView
                android:id="@+id/widget_music_icon"
                android:layout_width="22dp"
                android:layout_height="14dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_logo"
                android:tint="#FFFFFF" />

            <!-- Song Title & Artist -->
            <LinearLayout
                android:id="@+id/widget_text_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@id/widget_music_icon"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_marginEnd="6dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="normal"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/widget_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#B3FFFFFF"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginTop="1dp" />
            </LinearLayout>

            <!-- Bottom Controls (Matched to Apple Music sizing & spacing) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:gravity="center_horizontal"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_previous"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="6dp"
                    android:src="@drawable/ic_widget_previous"
                    android:tint="#FFFFFF" />

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="1dp" />

                <ImageView
                    android:id="@+id/widget_toggle"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="6dp"
                    android:src="@drawable/ic_widget_play"
                    android:tint="#FFFFFF" />

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="1dp" />

                <ImageView
                    android:id="@+id/widget_next"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="6dp"
                    android:src="@drawable/ic_widget_next"
                    android:tint="#FFFFFF" />
            </LinearLayout>

        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>
