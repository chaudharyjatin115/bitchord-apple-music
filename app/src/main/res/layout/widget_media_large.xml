<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Dynamic Tinted Rounded Background -->
    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/widget_apple_music_bg" />

    <!-- Foreground Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- TOP SECTION: NOW PLAYING -->
        <RelativeLayout
            android:id="@+id/now_playing_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Music Note Icon Top Right -->
            <ImageView
                android:id="@+id/widget_music_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:src="@drawable/ic_music_note"
                android:tint="#E0FFFFFF" />

            <!-- Large Artwork Left -->
            <ImageView
                android:id="@+id/widget_now_playing_art"
                android:layout_width="105dp"
                android:layout_height="105dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:scaleType="centerCrop" />

            <!-- Track Info & Pill Button Right -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/widget_now_playing_art"
                android:layout_toStartOf="@id/widget_music_icon"
                android:layout_alignTop="@id/widget_now_playing_art"
                android:layout_alignBottom="@id/widget_now_playing_art"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="6dp"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_now_playing_header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NOW PLAYING"
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_now_playing_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Everything Matters"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/widget_now_playing_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="AURORA"
                    android:textColor="#B3FFFFFF"
                    android:textSize="13sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:layout_marginTop="1dp" />

                <!-- Play/Pause Pill Button -->
                <LinearLayout
                    android:id="@+id/widget_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/widget_pill_bg"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:id="@+id/widget_pill_icon"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/ic_widget_pause"
                        android:tint="#FFFFFF" />

                    <TextView
                        android:id="@+id/widget_pill_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Pause"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>

        <!-- Divider Space -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <!-- BOTTOM SECTION: RECENTLY PLAYED -->
        <TextView
            android:id="@+id/widget_recently_played_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RECENTLY PLAYED"
            android:textColor="#B3FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Recent Item 1 -->
        <RelativeLayout
            android:id="@+id/recent_item_0"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="6dp"
            android:background="@drawable/widget_liquid_card_bg"
            android:paddingHorizontal="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/recent_art_0"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/recent_art_0"
                android:layout_toStartOf="@+id/recent_play_0"
                android:layout_centerVertical="true"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/recent_title_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/recent_artist_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:layout_marginTop="1dp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/recent_play_0"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/widget_circle_play_bg"
                android:padding="5dp"
                android:src="@drawable/ic_widget_play"
                android:tint="#FFFFFF" />
        </RelativeLayout>

        <!-- Recent Item 2 -->
        <RelativeLayout
            android:id="@+id/recent_item_1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="6dp"
            android:background="@drawable/widget_liquid_card_bg"
            android:paddingHorizontal="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/recent_art_1"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/recent_art_1"
                android:layout_toStartOf="@+id/recent_play_1"
                android:layout_centerVertical="true"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/recent_title_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/recent_artist_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:layout_marginTop="1dp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/recent_play_1"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/widget_circle_play_bg"
                android:padding="5dp"
                android:src="@drawable/ic_widget_play"
                android:tint="#FFFFFF" />
        </RelativeLayout>

        <!-- Recent Item 3 -->
        <RelativeLayout
            android:id="@+id/recent_item_2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/widget_liquid_card_bg"
            android:paddingHorizontal="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/recent_art_2"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/recent_art_2"
                android:layout_toStartOf="@+id/recent_play_2"
                android:layout_centerVertical="true"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/recent_title_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/recent_artist_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:layout_marginTop="1dp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/recent_play_2"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/widget_circle_play_bg"
                android:padding="5dp"
                android:src="@drawable/ic_widget_play"
                android:tint="#FFFFFF" />
        </RelativeLayout>
    </LinearLayout>
</FrameLayout>
